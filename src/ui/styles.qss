QMainWindow, QWidget { background: #11191A; color: #F2F4F7; font-family: "Segoe UI", Arial, sans-serif; }
QFrame#RootContainer { background: #11191A; border: 1px solid #263032; }
QFrame#WindowTitleBar { background: #11191A; border: none; }
QLabel#WindowTitleLabel { color: #F2F4F7; font-family: "Segoe UI", Arial, sans-serif; font-size: 12px; background: transparent; }
QFrame#Sidebar, QFrame#Panel, QFrame#Hero, QFrame#Details { background: #192122; border: 2px solid #394244; border-radius: 0px; }
QFrame#ImageHero { border: 1px solid rgba(255,255,255,45); border-radius: 0px; }
QLabel#Brand { color: #8FD9C4; font-family: "Minecraft", "Segoe UI"; font-size: 24px; font-weight: 800; }
QLabel#Muted { color: #A7ADB0; font-family: "Segoe UI", Arial, sans-serif; }
QLabel#HeroEyebrow, QLabel#HeroTitle, QLabel#HeroSubtitle { background: transparent; }
QLabel#HeroEyebrow { color: #101B22; letter-spacing: 3px; font-size: 11px; font-weight: 800; font-family: "Segoe UI", Arial, sans-serif; }
QLabel#HeroTitle { color: #08131B; font-family: "Minecraft", "Segoe UI"; font-size: 46px; font-weight: 900; letter-spacing: 2px; }
QLabel#HeroSubtitle { color: #102A32; font-size: 14px; font-weight: 600; font-family: "Segoe UI", Arial, sans-serif; }
QPushButton { background-color: #7D7D7D; color: #E0E0E0; font-family: "Minecraft", "Segoe UI"; font-size: 14px; font-weight: normal; padding: 10px 18px; border-top: 4px solid #AAAAAA; border-left: 4px solid #AAAAAA; border-right: 4px solid #555555; border-bottom: 4px solid #555555; border-radius: 0px; }
QPushButton:hover { background-color: #8B8B8B; color: #FFFFA0; border-top: 4px solid #FFFFFF; border-left: 4px solid #FFFFFF; }
QPushButton:pressed { background-color: #555555; border-top: 4px solid #333333; border-left: 4px solid #333333; border-right: 4px solid #8B8B8B; border-bottom: 4px solid #8B8B8B; padding-top: 12px; padding-bottom: 8px; }
QPushButton:disabled { background-color: #4A4A4A; color: #888888; border-top: 4px solid #606060; border-left: 4px solid #606060; border-right: 4px solid #333333; border-bottom: 4px solid #333333; }
QPushButton#Primary { background-color: #7D7D7D; color: #E0E0E0; font-family: "Minecraft", "Segoe UI"; font-weight: normal; }
QPushButton#Primary:hover { background-color: #8B8B8B; color: #FFFFA0; }
QPushButton#ModsFolderButton { padding: 0px; }
QPushButton#UpdateButton { background-color: #3C8527; color: #FFFFFF; font-family: "Minecraft", "Segoe UI"; font-size: 13px; border-top: 4px solid #63C741; border-left: 4px solid #63C741; border-right: 4px solid #2A641C; border-bottom: 4px solid #1E4A13; }
QPushButton#UpdateButton:hover { background-color: #469B2E; color: #FFFFA0; border-top: 4px solid #7AE856; border-left: 4px solid #7AE856; }
QPushButton#UpdateButton:pressed { background-color: #2A641C; border-top: 4px solid #1E4A13; border-left: 4px solid #1E4A13; border-right: 4px solid #3C8527; border-bottom: 4px solid #3C8527; }
QTextEdit#ReleaseNotesBox { background: #192122; color: #E0E0E0; border: 2px solid #394244; padding: 10px; font-family: "Segoe UI", Arial, sans-serif; font-size: 13px; }
QPushButton#TitleBarButton, QPushButton#TitleBarCloseButton { background-color: #11191A; color: #F2F4F7; border: none; border-radius: 0px; padding: 0px; }
QPushButton#TitleBarButton:hover { background-color: #242C2D; color: #FFFFFF; border: none; }
QPushButton#TitleBarButton:pressed { background-color: #323C3E; color: #FFFFFF; border: none; padding: 0px; }
QPushButton#TitleBarCloseButton:hover { background-color: #E81123; color: #FFFFFF; border: none; }
QPushButton#TitleBarCloseButton:pressed { background-color: #B50D1B; color: #FFFFFF; border: none; padding: 0px; }
QPushButton#PlayHero { background-color: #3C8527; color: #FFFFFF; font-family: "Minecraft", "Segoe UI"; font-size: 22px; font-weight: normal; letter-spacing: 2px; padding: 12px 40px; border-radius: 0px; border-top: 4px solid #52A535; border-left: 4px solid #52A535; border-right: 4px solid #2A641C; border-bottom: 6px solid #1E4A13; }
QPushButton#PlayHero:hover { background-color: #469B2E; border-top: 4px solid #63C741; border-left: 4px solid #63C741; }
QPushButton#PlayHero:pressed { background-color: #2A641C; border-top: 6px solid #1E4A13; border-left: 4px solid #1E4A13; border-right: 4px solid #3C8527; border-bottom: 4px solid #3C8527; padding-top: 14px; padding-bottom: 10px; }
QPushButton#PlayHero:disabled { background-color: #2D4A24; color: #95A590; border-top: 4px solid #3E6034; border-left: 4px solid #3E6034; border-right: 4px solid #1E3318; border-bottom: 6px solid #162612; }
QToolTip { background-color: #192122; color: #FFFFA0; border: 2px solid #8FD9C4; padding: 6px 10px; font-family: "Segoe UI", Arial, sans-serif; font-size: 12px; }
QPushButton::menu-indicator { image: none; width: 0px; }
QComboBox, QLineEdit, QSpinBox { background: #242C2D; border: 2px solid #454E50; border-radius: 0px; padding: 9px; selection-background-color: #238A6C; font-family: "Segoe UI", Arial, sans-serif; font-size: 13px; }
QComboBox:hover, QLineEdit:focus, QSpinBox:focus { border-color: #AAAAAA; }
QComboBox#HeroSelector { background-color: #7D7D7D; color: #E0E0E0; font-family: "Segoe UI", Arial, sans-serif; font-size: 15px; font-weight: 600; padding: 10px 16px; border-top: 4px solid #AAAAAA; border-left: 4px solid #AAAAAA; border-right: 4px solid #555555; border-bottom: 4px solid #555555; border-radius: 0px; }
QComboBox#HeroSelector:hover { background-color: #8B8B8B; color: #FFFFA0; border-top-color: #FFFFFF; border-left-color: #FFFFFF; }
QComboBox#HeroSelector::drop-down { width: 36px; border: none; }
QComboBox#HeroSelector QAbstractItemView { background: #7D7D7D; color: #E0E0E0; border: 4px solid #555555; selection-background-color: #555555; selection-color: #FFFFA0; padding: 5px; font-family: "Segoe UI", Arial, sans-serif; }
QMenu { background: #7D7D7D; color: #E0E0E0; font-family: "Minecraft", "Segoe UI"; border-top: 4px solid #AAAAAA; border-left: 4px solid #AAAAAA; border-right: 4px solid #555555; border-bottom: 4px solid #555555; border-radius: 0px; padding: 4px; }
QMenu::item { padding: 10px 24px 10px 12px; font-family: "Minecraft", "Segoe UI"; font-size: 13px; font-weight: normal; }
QMenu::item:selected { background: #555555; color: #FFFFA0; }
QListWidget { background: #11141A; border: 1px solid #232630; border-radius: 9px; padding: 6px; }
QListWidget::item { padding: 12px; border-radius: 7px; }
QListWidget::item:selected { background: #1E5F50; }
QProgressBar { background: #242C2D; border: 1px solid #454E50; border-radius: 0px; height: 7px; }
QProgressBar::chunk { background: #41D6A4; border-radius: 0px; }
QCheckBox { color: #E0E0E0; font-family: "Segoe UI", Arial, sans-serif; font-size: 13px; font-weight: 600; spacing: 8px; padding: 4px 0px; }
QCheckBox::indicator { width: 18px; height: 18px; background: #242C2D; border: 2px solid #7D7D7D; }
QCheckBox::indicator:hover { border-color: #FFFFA0; }
QCheckBox::indicator:checked { background: #3C8527; border: 2px solid #63C741; }